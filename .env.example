# 환경 파일은 둘이다. .env* 는 git 제외 — 이 예시 파일만 커밋한다. 아래 두 묶음을 각 파일에 나눠 쓴다.
#   .env         외부 서비스의 키 · 주소 전부 (Qdrant Cloud …) + 로컬 Docker(PostgreSQL) 계정. 외부 서비스가 늘어도 여기에 더한다
#   .env.config  켜고 끄는 값. 키 · 주소는 넣지 않는다
# 실행: uv run --env-file .env --env-file .env.config <명령>  (두 파일은 비어 있어도 있어야 한다)
# docker compose 도 .env 를 저절로 읽지만 아래 POSTGRES_* 와 'docker compose' 묶음만 쓴다 — 키는 컨테이너로 넘어가지 않는다.
# compose 는 값 속의 $ 를 변수로 읽으니, 키에 $ 가 있으면 작은따옴표로 감싼다

# ===== .env =====
# 로컬 Docker(PostgreSQL) 계정 — 비우면 docker-compose.yml 기본값(rag)
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
# Qdrant Cloud — .env.config 의 QDRANT_MODE=cloud 일 때만 쓴다
# QDRANT_URL=https://<클러스터 id>.<리전>.cloud.qdrant.io:6333
# QDRANT_API_KEY=
# 로컬 Qdrant 주소 — 비우면 http://localhost:6333. gRPC 는 포트 6334 로 붙으니, 아래 QDRANT_PORT 를 바꿨으면 .env.config 에 QDRANT_GRPC=0 도 둔다
# QDRANT_LOCAL_URL=http://localhost:6333

# ----- docker compose -----
# 호스트 포트 — 다른 컨테이너와 겹칠 때만 바꾼다. QDRANT_PORT 를 바꾸면 호스트에서 돌리는 스크립트는 위 QDRANT_LOCAL_URL 로 그 포트에 붙는다
# PG_PORT=5432
# QDRANT_PORT=6333
# QDRANT_GRPC_PORT=6334
# API_PORT=8000
# api 서비스 (docker compose --profile api)
# RAG_COLLECTION=kowiki-subset-10000_kure-v1  # 비우면 서브셋. 전체는 kowiki_kure-v1 (data/index/bm25/ 에 그 색인이 있어야 한다)
# HF_CACHE_DIR=~/.cache/huggingface            # 임베딩 · 리랭커 모델 캐시 (호스트 폴더)
# OLLAMA_URL=http://host.docker.internal:11434  # 답을 만드는 Ollama (호스트)

# ===== .env.config =====
# QDRANT_MODE=local      # local(기본, 로컬 Docker — .env 의 QDRANT_LOCAL_URL, 비우면 http://localhost:6333) · cloud(.env 의 주소 · 키)
# QDRANT_GRPC=1          # 0 이면 REST
# QDRANT_TIMEOUT=60      # 초. 비우면 5초
# RAG_LOG_QUESTIONS=0    # 1 이면 /ask 질문 원문을 로그에 남긴다. 기본은 길이 · SHA-256 만
# RAG_IMPL=real          # mock 이면 PG · Qdrant · Ollama · GPU · 검색 모델 없이 예시 검색 결과 · FakeLLM 으로 뜬다 (프런트엔드 개발용, README "목업 모드로 띄우기")
